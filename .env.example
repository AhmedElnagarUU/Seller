# Public base URL of the app, no trailing slash
APP_URL=http://localhost:3000
# MongoDB connection string (local single-node replica set from docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/themestore?replicaSet=rs0&directConnection=true
# S3-compatible endpoint (local MinIO)
S3_ENDPOINT=http://localhost:9000
# S3 region (us-east-1 for MinIO)
S3_REGION=us-east-1
# S3 access key id
S3_ACCESS_KEY_ID=minioadmin
# S3 secret access key
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO, false for Cloudflare R2
S3_FORCE_PATH_STYLE=true
# Private bucket for theme zips and wallet proof screenshots
S3_PRIVATE_BUCKET=store-files
# Public bucket for theme images
S3_PUBLIC_BUCKET=store-images
# Public base URL of the images bucket, no trailing slash
PUBLIC_IMAGES_BASE_URL=http://localhost:9000/store-images
# Shows /dev/* pages (UI kit preview). Never set in production.
ENABLE_DEV_PAGES=true
# local | ci | staging | production. Production-only safety rules use this (not NODE_ENV, which `next build` always sets to production).
APP_ENV=local
# Secret used by Better Auth to sign sessions (32+ random characters)
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
# Public base URL for Better Auth, no trailing slash (same as APP_URL)
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client id
GOOGLE_CLIENT_ID=dev-google-client-id
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=dev-google-client-secret
# Admin emails, comma separated, case-insensitive
ADMIN_EMAILS=admin@example.com
# "resend" sends real emails; "console" prints them (local and E2E only, refused in production)
EMAIL_TRANSPORT=console
# Resend API key (required when EMAIL_TRANSPORT=resend)
RESEND_API_KEY=
# From address of all emails
EMAIL_FROM=Theme Store <hello@example.com>
# Support email shown in emails and used as reply-to
SUPPORT_EMAIL=support@example.com
